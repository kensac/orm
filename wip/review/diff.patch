+    ...(args.to === undefined ? [] : [`--to ${args.to}`]),
+    '--db $DATABASE_URL',
+  ].join(' ');
+  return requireLiveDatabase({
+    dbConnection: args.dbConnection,
+    hasDriver: args.hasDriver,
+    why: `${LIVE_MARKER_REF} resolves to the live database marker and requires a --db connection`,
+    retryCommand,
