+  '@empty',
+]);
+
+export function isReservedContractRef(input: string): boolean {
+  return RESERVED_CONTRACT_REFS.has(input);
+}
+
+export function isLiveMarkerRef(input: string | undefined): boolean {
+  return input === LIVE_MARKER_REF;
